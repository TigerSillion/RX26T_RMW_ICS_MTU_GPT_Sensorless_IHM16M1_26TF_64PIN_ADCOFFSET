<UserControl x:Class="PcDebugGui.App.Views.OscilloscopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="触发通道" VerticalAlignment="Center" />
            <TextBox Width="120" Margin="8,0" Text="{Binding TriggerChannel}" />
            <TextBlock Text="时基" VerticalAlignment="Center" />
            <TextBox Width="120" Margin="8,0" Text="{Binding Timebase}" />
            <TextBlock Text="缩放" VerticalAlignment="Center" />
            <TextBox Width="120" Margin="8,0" Text="{Binding ZoomLevel}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,8" Background="#101820" CornerRadius="4" BorderBrush="#2A9D8F" BorderThickness="1">
            <TextBlock Foreground="#8EF0D0" FontFamily="Consolas" Text="波形预览区域（预留实时绘图控件）" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Channels}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Enabled}" Header="启用" Width="70" />
                <DataGridTextColumn Binding="{Binding Name}" Header="通道" Width="140" />
                <DataGridTextColumn Binding="{Binding Color}" Header="颜色" Width="120" />
                <DataGridTextColumn Binding="{Binding TriggerMode}" Header="触发" Width="120" />
                <DataGridTextColumn Binding="{Binding LastValue}" Header="最新值" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
