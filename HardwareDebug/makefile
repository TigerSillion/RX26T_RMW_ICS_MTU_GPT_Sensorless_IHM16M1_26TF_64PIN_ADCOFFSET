# Other Targets
clean:
	-$(file > clean_file.tmp, $(LINKER_OUTPUT_OUTPUTS) $(LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS) $(CONVERTOR_OUTPUT_OUTPUTS) $(OBJS) $(ALL_COMMON_DEPS) $(DSP_DEPS) $(DSP_UPPER_DEPS) $(OUTPUT_FILES))
	-@ xargs -P 2 -s 26000 -t -a clean_file.tmp $(RM)
	-@$(RM) clean_file.tmp
	@echo ''
	@echo 'Clean complete.'

post-build:
	@echo ''
	-cmd /c "copy C:\A_sw_workspace\e2s_workspace\e2workspace_202512\RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1\HardwareDebug\\RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.map C:\A_sw_workspace\e2s_workspace\e2workspace_202512\RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1\app\rmw\\RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.map && cd /d C:\A_sw_workspace\e2s_workspace\e2workspace_202512\RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1\app\rmw && map2csv_RELCC.exe RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.map var.csv"
	@echo ''

