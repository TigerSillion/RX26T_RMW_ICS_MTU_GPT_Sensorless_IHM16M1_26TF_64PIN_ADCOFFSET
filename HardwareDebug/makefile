LINKER_OUTPUT_OUTPUTS += \
RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.abs

LIBRARY_GENERATOR_OUTPUTTYPE_OUTPUTS += \
RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.lib

CONVERTOR_OUTPUT_OUTPUTS += \
RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.mot

OBJS := \
$(COMPILER_OBJS) \
$(INDIVIDUAL_COMPILER_OBJS) \
$(ASSEMBLER_OBJS) \
$(CUSTOM_OBJS)

# All Target
all: RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.x RX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.udm $(CONVERTOR_OUTPUT_OUTPUTS) 
	$(MAKE) --no-print-directory post-build
	@echo 'Build complete.'

%.mot: $(LINKER_OUTPUT_OUTPUTS) Converter.sub
	@echo 'Invoking Converter: $@'
	@echo ConverterRX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.tmp=
	@sed -e "s/^/    /" "ConverterRX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.tmp"
	rlink -subcommand="ConverterRX26T_RMW_ICS_MTU_GPT_Sensorless_IHM16M1.tmp"


